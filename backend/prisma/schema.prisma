generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model account_tokens {
  id         BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    BigInt                 @db.UnsignedBigInt
  purpose    account_tokens_purpose @default(RESET_PASSWORD)
  token_hash String                 @unique(map: "uq_account_token") @db.VarChar(64)
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime               @default(now())
  updated_at DateTime               @default(now())
  users      users                  @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "fk_account_tokens_1")

  @@index([user_id], map: "fk_account_tokens_1")
}

model addresses {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id        BigInt    @db.UnsignedBigInt
  recipient_name String    @db.VarChar(120)
  phone          String    @db.VarChar(20)
  address_line   String    @db.VarChar(500)
  delivery_note  String?   @db.VarChar(500)
  latitude       Decimal?  @db.Decimal(10, 7)
  longitude      Decimal?  @db.Decimal(10, 7)
  is_default     Boolean   @default(false)
  deleted_at     DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @default(now())
  users          users     @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "fk_addresses_1")

  @@index([user_id, deleted_at], map: "ix_addresses_user")
}

model ai_conversations {
  id               BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  user_id          BigInt?       @db.UnsignedBigInt
  guest_token_hash String?       @db.VarChar(64)
  title            String?       @db.VarChar(200)
  expires_at       DateTime?
  deleted_at       DateTime?
  created_at       DateTime      @default(now())
  updated_at       DateTime      @default(now())
  users            users?        @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_ai_conversations_1")
  ai_messages      ai_messages[]

  @@index([user_id, created_at], map: "ix_conversation_user")
}

model ai_messages {
  id                   BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  conversation_id      BigInt                 @db.UnsignedBigInt
  role                 ai_messages_role       @default(USER)
  content              String                 @db.Text
  structured_data      Json?
  model_name           String?                @db.VarChar(100)
  input_tokens         Int?                   @db.UnsignedInt
  output_tokens        Int?                   @db.UnsignedInt
  created_at           DateTime               @default(now())
  updated_at           DateTime               @default(now())
  ai_conversations     ai_conversations       @relation(fields: [conversation_id], references: [id], onUpdate: Restrict, map: "fk_ai_messages_1")
  recommendation_items recommendation_items[]

  @@index([conversation_id, created_at, id], map: "ix_messages_conversation")
}

model auth_sessions {
  id                 BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id            BigInt    @db.UnsignedBigInt
  refresh_token_hash String    @unique(map: "uq_sessions_token") @db.VarChar(64)
  expires_at         DateTime
  revoked_at         DateTime?
  user_agent         String?   @db.VarChar(512)
  created_at         DateTime  @default(now())
  updated_at         DateTime  @default(now())
  users              users     @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "fk_auth_sessions_1")

  @@index([user_id, expires_at], map: "ix_sessions_user_expiry")
}

model cart_item_options {
  id              BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  cart_item_id    BigInt        @db.UnsignedBigInt
  dish_id         BigInt        @db.UnsignedBigInt
  option_value_id BigInt        @db.UnsignedBigInt
  created_at      DateTime      @default(now())
  updated_at      DateTime      @default(now())
  cart_items      cart_items    @relation(fields: [cart_item_id, dish_id], references: [id, dish_id], onUpdate: Restrict, map: "fk_cart_item_options_1")
  option_values   option_values @relation(fields: [option_value_id, dish_id], references: [id, dish_id], onUpdate: Restrict, map: "fk_cart_item_options_2")

  @@unique([cart_item_id, option_value_id], map: "uq_cart_option")
  @@index([cart_item_id, dish_id], map: "fk_cart_item_options_1")
  @@index([option_value_id, dish_id], map: "fk_cart_item_options_2")
}

model cart_items {
  id                BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  cart_id           BigInt              @db.UnsignedBigInt
  dish_id           BigInt              @db.UnsignedBigInt
  variant_id        BigInt              @db.UnsignedBigInt
  quantity          Int                 @db.UnsignedSmallInt
  note              String?             @db.VarChar(500)
  created_at        DateTime            @default(now())
  updated_at        DateTime            @default(now())
  cart_item_options cart_item_options[]
  carts             carts               @relation(fields: [cart_id], references: [id], onUpdate: Restrict, map: "fk_cart_items_1")
  dish_variants     dish_variants       @relation(fields: [variant_id, dish_id], references: [id, dish_id], onUpdate: Restrict, map: "fk_cart_items_2")

  @@unique([id, dish_id], map: "uq_cart_item_id_dish")
  @@index([cart_id], map: "fk_cart_items_1")
  @@index([variant_id, dish_id], map: "fk_cart_items_2")
}

model carts {
  id         BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    BigInt       @unique(map: "uq_cart_user") @db.UnsignedBigInt
  created_at DateTime     @default(now())
  updated_at DateTime     @default(now())
  cart_items cart_items[]
  users      users        @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "fk_carts_1")
}

model categories {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name       String   @db.VarChar(100)
  slug       String   @unique(map: "uq_categories_slug") @db.VarChar(140)
  sort_order Int      @default(0)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
  dishes     dishes[]
}

model coupon_redemptions {
  id              BigInt                    @id @default(autoincrement()) @db.UnsignedBigInt
  coupon_id       BigInt                    @db.UnsignedBigInt
  order_id        BigInt                    @unique(map: "uq_redemption_order") @db.UnsignedBigInt
  user_id         BigInt                    @db.UnsignedBigInt
  status          coupon_redemptions_status @default(RESERVED)
  discount_amount Decimal                   @default(0) @db.Decimal(12, 0)
  released_at     DateTime?
  created_at      DateTime                  @default(now())
  updated_at      DateTime                  @default(now())
  coupons         coupons                   @relation(fields: [coupon_id], references: [id], onUpdate: Restrict, map: "fk_coupon_redemptions_1")
  orders          orders                    @relation(fields: [order_id, user_id], references: [id, user_id], onUpdate: Restrict, map: "fk_coupon_redemptions_2")

  @@unique([order_id, user_id], map: "fk_coupon_redemptions_2")
  @@index([coupon_id, user_id, status], map: "ix_redemption_limit")
}

model coupons {
  id                 BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  code               String                @unique(map: "uq_coupon_code") @db.VarChar(40)
  name               String                @db.VarChar(160)
  discount_type      coupons_discount_type @default(FIXED)
  discount_value     Decimal               @default(0) @db.Decimal(12, 0)
  min_subtotal       Decimal               @default(0) @db.Decimal(12, 0)
  max_discount       Decimal?              @db.Decimal(12, 0)
  starts_at          DateTime
  ends_at            DateTime
  total_limit        Int?                  @db.UnsignedInt
  per_user_limit     Int                   @default(1) @db.UnsignedInt
  is_active          Boolean               @default(true)
  created_at         DateTime              @default(now())
  updated_at         DateTime              @default(now())
  coupon_redemptions coupon_redemptions[]
  orders             orders[]
}

model dish_images {
  id             BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  dish_id        BigInt           @db.UnsignedBigInt
  asset_path     String           @db.VarChar(500)
  kind           dish_images_kind @default(GALLERY)
  alt_text       String           @db.VarChar(255)
  sort_order     Int              @default(0)
  created_at     DateTime         @default(now())
  updated_at     DateTime         @default(now())
  dishes         dishes           @relation(fields: [dish_id], references: [id], onUpdate: Restrict, map: "fk_dish_images_1")
  story_sections story_sections[]

  @@index([dish_id, kind, sort_order], map: "ix_images_dish")
}

model dish_ingredients {
  id            BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  dish_id       BigInt      @db.UnsignedBigInt
  ingredient_id BigInt      @db.UnsignedBigInt
  note          String?     @db.Text
  created_at    DateTime    @default(now())
  updated_at    DateTime    @default(now())
  dishes        dishes      @relation(fields: [dish_id], references: [id], onUpdate: Restrict, map: "fk_dish_ingredients_1")
  ingredients   ingredients @relation(fields: [ingredient_id], references: [id], onUpdate: Restrict, map: "fk_dish_ingredients_2")

  @@unique([dish_id, ingredient_id], map: "uq_dish_ingredients")
  @@index([ingredient_id], map: "fk_dish_ingredients_2")
}

model dish_tags {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  dish_id    BigInt   @db.UnsignedBigInt
  tag_id     BigInt   @db.UnsignedBigInt
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
  dishes     dishes   @relation(fields: [dish_id], references: [id], onUpdate: Restrict, map: "fk_dish_tags_1")
  tags       tags     @relation(fields: [tag_id], references: [id], onUpdate: Restrict, map: "fk_dish_tags_2")

  @@unique([dish_id, tag_id], map: "uq_dish_tags")
  @@index([tag_id], map: "fk_dish_tags_2")
}

model dish_variants {
  id          BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  dish_id     BigInt        @db.UnsignedBigInt
  name        String        @db.VarChar(100)
  price       Decimal       @default(0) @db.Decimal(12, 0)
  is_active   Boolean       @default(true)
  created_at  DateTime      @default(now())
  updated_at  DateTime      @default(now())
  cart_items  cart_items[]
  dishes      dishes        @relation(fields: [dish_id], references: [id], onUpdate: Restrict, map: "fk_dish_variants_1")
  order_items order_items[]

  @@unique([id, dish_id], map: "uq_variants_id_dish")
  @@unique([dish_id, name], map: "uq_variants_name")
}

model dishes {
  id                     BigInt                        @id @default(autoincrement()) @db.UnsignedBigInt
  category_id            BigInt                        @db.UnsignedBigInt
  name                   String                        @db.VarChar(160)
  slug                   String                        @unique(map: "uq_dishes_slug") @db.VarChar(180)
  description            String?                       @db.Text
  story                  String?                       @db.Text
  spicy_level            Int?                          @db.UnsignedTinyInt
  ingredient_data_status dishes_ingredient_data_status @default(UNKNOWN)
  availability           dishes_availability           @default(HIDDEN)
  sort_order             Int                           @default(0)
  deleted_at             DateTime?
  created_at             DateTime                      @default(now())
  updated_at             DateTime                      @default(now())
  dish_images            dish_images[]
  dish_ingredients       dish_ingredients[]
  dish_tags              dish_tags[]
  dish_variants          dish_variants[]
  categories             categories                    @relation(fields: [category_id], references: [id], onUpdate: Restrict, map: "fk_dishes_1")
  favorites              favorites[]
  option_groups          option_groups[]
  recommendation_items   recommendation_items[]
  story_sections         story_sections[]
  user_interactions      user_interactions[]

  @@index([category_id, availability, deleted_at], map: "ix_dishes_category_sale")
}

model favorites {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    BigInt   @db.UnsignedBigInt
  dish_id    BigInt   @db.UnsignedBigInt
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
  users      users    @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "fk_favorites_1")
  dishes     dishes   @relation(fields: [dish_id], references: [id], onUpdate: Restrict, map: "fk_favorites_2")

  @@unique([user_id, dish_id], map: "uq_favorite")
  @@index([dish_id], map: "fk_favorites_2")
}

model ingredients {
  id                           BigInt                         @id @default(autoincrement()) @db.UnsignedBigInt
  name                         String                         @db.VarChar(120)
  code                         String                         @unique(map: "uq_ingredients_code") @db.VarChar(100)
  is_allergen                  Boolean                        @default(false)
  created_at                   DateTime                       @default(now())
  updated_at                   DateTime                       @default(now())
  dish_ingredients             dish_ingredients[]
  user_ingredient_restrictions user_ingredient_restrictions[]
}

model option_groups {
  id            BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  dish_id       BigInt          @db.UnsignedBigInt
  name          String          @db.VarChar(100)
  min_select    Int             @default(0) @db.UnsignedSmallInt
  max_select    Int             @default(1) @db.UnsignedSmallInt
  is_active     Boolean         @default(true)
  created_at    DateTime        @default(now())
  updated_at    DateTime        @default(now())
  dishes        dishes          @relation(fields: [dish_id], references: [id], onUpdate: Restrict, map: "fk_option_groups_1")
  option_values option_values[]

  @@unique([id, dish_id], map: "uq_groups_id_dish")
  @@index([dish_id], map: "fk_option_groups_1")
}

model option_values {
  id                 BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  group_id           BigInt               @db.UnsignedBigInt
  dish_id            BigInt               @db.UnsignedBigInt
  name               String               @db.VarChar(100)
  extra_price        Decimal              @default(0) @db.Decimal(12, 0)
  is_active          Boolean              @default(true)
  created_at         DateTime             @default(now())
  updated_at         DateTime             @default(now())
  cart_item_options  cart_item_options[]
  option_groups      option_groups        @relation(fields: [group_id, dish_id], references: [id, dish_id], onUpdate: Restrict, map: "fk_option_values_1")
  order_item_options order_item_options[]

  @@unique([group_id, name], map: "uq_options_group_name")
  @@unique([id, dish_id], map: "uq_options_id_dish")
  @@index([group_id, dish_id], map: "fk_option_values_1")
}

model order_events {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  order_id      BigInt   @db.UnsignedBigInt
  actor_user_id BigInt?  @db.UnsignedBigInt
  event_type    String   @db.VarChar(60)
  from_status   String?  @db.VarChar(40)
  to_status     String?  @db.VarChar(40)
  note          String?  @db.VarChar(1000)
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now())
  orders        orders   @relation(fields: [order_id], references: [id], onUpdate: Restrict, map: "fk_order_events_1")
  users         users?   @relation(fields: [actor_user_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_order_events_2")

  @@index([actor_user_id], map: "fk_order_events_2")
  @@index([order_id, created_at, id], map: "ix_order_events")
}

model order_item_options {
  id              BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  order_item_id   BigInt        @db.UnsignedBigInt
  dish_id         BigInt        @db.UnsignedBigInt
  option_value_id BigInt        @db.UnsignedBigInt
  group_name      String        @db.VarChar(100)
  option_name     String        @db.VarChar(100)
  extra_price     Decimal       @default(0) @db.Decimal(12, 0)
  created_at      DateTime      @default(now())
  updated_at      DateTime      @default(now())
  order_items     order_items   @relation(fields: [order_item_id, dish_id], references: [id, dish_id], onUpdate: Restrict, map: "fk_order_item_options_1")
  option_values   option_values @relation(fields: [option_value_id, dish_id], references: [id, dish_id], onUpdate: Restrict, map: "fk_order_item_options_2")

  @@unique([order_item_id, option_value_id], map: "uq_order_option")
  @@index([order_item_id, dish_id], map: "fk_order_item_options_1")
  @@index([option_value_id, dish_id], map: "fk_order_item_options_2")
}

model order_items {
  id                 BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  order_id           BigInt               @db.UnsignedBigInt
  dish_id            BigInt               @db.UnsignedBigInt
  variant_id         BigInt               @db.UnsignedBigInt
  dish_name          String               @db.VarChar(160)
  variant_name       String               @db.VarChar(100)
  base_price         Decimal              @default(0) @db.Decimal(12, 0)
  options_price      Decimal              @default(0) @db.Decimal(12, 0)
  quantity           Int                  @db.UnsignedSmallInt
  line_total         Decimal              @default(0) @db.Decimal(12, 0)
  note               String?              @db.VarChar(500)
  created_at         DateTime             @default(now())
  updated_at         DateTime             @default(now())
  order_item_options order_item_options[]
  orders             orders               @relation(fields: [order_id], references: [id], onUpdate: Restrict, map: "fk_order_items_1")
  dish_variants      dish_variants        @relation(fields: [variant_id, dish_id], references: [id, dish_id], onUpdate: Restrict, map: "fk_order_items_2")
  reviews            reviews?

  @@unique([id, dish_id], map: "uq_order_item_id_dish")
  @@index([order_id], map: "fk_order_items_1")
  @@index([variant_id, dish_id], map: "fk_order_items_2")
  @@index([dish_id], map: "ix_order_items_dish")
}

model orders {
  id                 BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  order_code         String                  @unique(map: "uq_order_code") @db.VarChar(32)
  checkout_key       String                  @unique(map: "uq_checkout_key") @db.VarChar(64)
  user_id            BigInt                  @db.UnsignedBigInt
  fulfillment_type   orders_fulfillment_type @default(DELIVERY)
  status             orders_status           @default(PENDING_CONFIRMATION)
  payment_method     orders_payment_method   @default(COD)
  payment_status     orders_payment_status   @default(UNPAID)
  recipient_name     String                  @db.VarChar(120)
  recipient_phone    String                  @db.VarChar(20)
  delivery_address   String?                 @db.VarChar(500)
  delivery_note      String?                 @db.VarChar(500)
  customer_note      String?                 @db.VarChar(500)
  subtotal           Decimal                 @default(0) @db.Decimal(12, 0)
  food_discount      Decimal                 @default(0) @db.Decimal(12, 0)
  delivery_fee       Decimal                 @default(0) @db.Decimal(12, 0)
  shipping_discount  Decimal                 @default(0) @db.Decimal(12, 0)
  total_amount       Decimal                 @default(0) @db.Decimal(12, 0)
  coupon_id          BigInt?                 @db.UnsignedBigInt
  coupon_snapshot    Json?
  payment_deadline   DateTime?
  estimated_ready_at DateTime?
  completed_at       DateTime?
  cancelled_at       DateTime?
  cancel_reason      String?                 @db.VarChar(500)
  created_at         DateTime                @default(now())
  updated_at         DateTime                @default(now())
  coupon_redemptions coupon_redemptions?
  order_events       order_events[]
  order_items        order_items[]
  users              users                   @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "fk_orders_1")
  coupons            coupons?                @relation(fields: [coupon_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_orders_2")
  payments           payments[]

  @@unique([id, user_id], map: "uq_orders_id_user")
  @@index([coupon_id], map: "fk_orders_2")
  @@index([status, payment_deadline], map: "ix_orders_payment_expiry")
  @@index([status, created_at], map: "ix_orders_status_created")
  @@index([user_id, created_at], map: "ix_orders_user_created")
}

model payment_events {
  id                BigInt                           @id @default(autoincrement()) @db.UnsignedBigInt
  payment_id        BigInt?                          @db.UnsignedBigInt
  provider          String                           @db.VarChar(30)
  event_key         String
  signature_valid   Boolean                          @default(false)
  payload           Json
  processing_status payment_events_processing_status @default(RECEIVED)
  processed_at      DateTime?
  error_note        String?                          @db.VarChar(500)
  created_at        DateTime                         @default(now())
  updated_at        DateTime                         @default(now())
  payments          payments?                        @relation(fields: [payment_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_payment_events_1")

  @@unique([provider, event_key], map: "uq_payment_event")
  @@index([payment_id], map: "fk_payment_events_1")
}

model payments {
  id                      BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  order_id                BigInt            @db.UnsignedBigInt
  provider                payments_provider @default(VNPAY)
  merchant_reference      String            @unique(map: "uq_payment_reference") @db.VarChar(100)
  provider_transaction_id String?           @db.VarChar(150)
  amount                  Decimal           @default(0) @db.Decimal(12, 0)
  currency                String            @default("VND") @db.Char(3)
  status                  payments_status   @default(PENDING)
  paid_at                 DateTime?
  expires_at              DateTime?
  created_at              DateTime          @default(now())
  updated_at              DateTime          @default(now())
  payment_events          payment_events[]
  orders                  orders            @relation(fields: [order_id], references: [id], onUpdate: Restrict, map: "fk_payments_1")
  refunds                 refunds[]

  @@unique([provider, provider_transaction_id], map: "uq_provider_transaction")
  @@index([order_id, status], map: "ix_payment_order")
}

model recommendation_items {
  id                BigInt                      @id @default(autoincrement()) @db.UnsignedBigInt
  user_id           BigInt?                     @db.UnsignedBigInt
  message_id        BigInt?                     @db.UnsignedBigInt
  dish_id           BigInt                      @db.UnsignedBigInt
  batch_key         String                      @db.VarChar(64)
  source            recommendation_items_source @default(AI_CHAT)
  rank_position     Int                         @db.UnsignedSmallInt
  score             Decimal?                    @db.Decimal(8, 4)
  reason            String?                     @db.VarChar(500)
  expires_at        DateTime?
  created_at        DateTime                    @default(now())
  updated_at        DateTime                    @default(now())
  users             users?                      @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_recommendation_items_1")
  ai_messages       ai_messages?                @relation(fields: [message_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_recommendation_items_2")
  dishes            dishes                      @relation(fields: [dish_id], references: [id], onUpdate: Restrict, map: "fk_recommendation_items_3")
  user_interactions user_interactions[]

  @@unique([batch_key, rank_position], map: "uq_recommendation_rank")
  @@index([message_id], map: "fk_recommendation_items_2")
  @@index([dish_id], map: "fk_recommendation_items_3")
  @@index([user_id, created_at], map: "ix_recommendation_user")
}

model refunds {
  id                 BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  payment_id         BigInt         @db.UnsignedBigInt
  refund_reference   String         @unique(map: "uq_refund_reference") @db.VarChar(100)
  provider_refund_id String?        @db.VarChar(150)
  amount             Decimal        @default(0) @db.Decimal(12, 0)
  reason             String         @db.VarChar(500)
  status             refunds_status @default(REQUESTED)
  requested_by       BigInt         @db.UnsignedBigInt
  refunded_at        DateTime?
  created_at         DateTime       @default(now())
  updated_at         DateTime       @default(now())
  payments           payments       @relation(fields: [payment_id], references: [id], onUpdate: Restrict, map: "fk_refunds_1")
  users              users          @relation(fields: [requested_by], references: [id], onUpdate: Restrict, map: "fk_refunds_2")

  @@index([requested_by], map: "fk_refunds_2")
  @@index([payment_id, status], map: "ix_refunds_payment_status")
}

model reviews {
  id                BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  order_item_id     BigInt             @unique(map: "uq_review_item") @db.UnsignedBigInt
  rating            Int                @db.UnsignedTinyInt
  content           String?            @db.Text
  visibility        reviews_visibility @default(VISIBLE)
  moderation_reason String?            @db.VarChar(500)
  reply             String?            @db.Text
  replied_by        BigInt?            @db.UnsignedBigInt
  replied_at        DateTime?
  created_at        DateTime           @default(now())
  updated_at        DateTime           @default(now())
  order_items       order_items        @relation(fields: [order_item_id], references: [id], onUpdate: Restrict, map: "fk_reviews_1")
  users             users?             @relation(fields: [replied_by], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_reviews_2")

  @@index([replied_by], map: "fk_reviews_2")
}

model store_settings {
  id                      BigInt   @id @db.UnsignedBigInt
  name                    String   @db.VarChar(160)
  address                 String   @db.VarChar(500)
  phone                   String   @db.VarChar(20)
  opening_hours           Json
  delivery_rules          Json
  accepting_orders        Boolean  @default(true)
  payment_timeout_minutes Int      @default(15) @db.UnsignedSmallInt
  created_at              DateTime @default(now())
  updated_at              DateTime @default(now())
}

model story_sections {
  id               BigInt                          @id @default(autoincrement()) @db.UnsignedBigInt
  dish_id          BigInt                          @db.UnsignedBigInt
  image_id         BigInt?                         @db.UnsignedBigInt
  chapter_label    String                          @db.VarChar(100)
  headline         String                          @db.VarChar(200)
  body             String                          @db.Text
  cta_label        String                          @db.VarChar(100)
  background_color String                          @db.VarChar(7)
  text_color       String                          @db.VarChar(7)
  animation_preset story_sections_animation_preset @default(ROLL_LEFT)
  sort_order       Int                             @default(0)
  is_published     Boolean                         @default(false)
  extra_assets     Json?
  created_at       DateTime                        @default(now())
  updated_at       DateTime                        @default(now())
  dishes           dishes                          @relation(fields: [dish_id], references: [id], onUpdate: Restrict, map: "fk_story_sections_1")
  dish_images      dish_images?                    @relation(fields: [image_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_story_sections_2")

  @@index([dish_id], map: "fk_story_sections_1")
  @@index([image_id], map: "fk_story_sections_2")
  @@index([is_published, sort_order], map: "ix_story_public")
}

model tags {
  id                   BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  code                 String                 @unique(map: "uq_tags_code") @db.VarChar(80)
  name                 String                 @db.VarChar(100)
  created_at           DateTime               @default(now())
  updated_at           DateTime               @default(now())
  dish_tags            dish_tags[]
  user_tag_preferences user_tag_preferences[]
}

model user_ingredient_restrictions {
  id            BigInt                              @id @default(autoincrement()) @db.UnsignedBigInt
  user_id       BigInt                              @db.UnsignedBigInt
  ingredient_id BigInt                              @db.UnsignedBigInt
  reason        user_ingredient_restrictions_reason @default(DISLIKE)
  created_at    DateTime                            @default(now())
  updated_at    DateTime                            @default(now())
  users         users                               @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "fk_user_ingredient_restrictions_1")
  ingredients   ingredients                         @relation(fields: [ingredient_id], references: [id], onUpdate: Restrict, map: "fk_user_ingredient_restrictions_2")

  @@unique([user_id, ingredient_id], map: "uq_user_ingredient")
  @@index([ingredient_id], map: "fk_user_ingredient_restrictions_2")
}

model user_interactions {
  id                   BigInt                       @id @default(autoincrement()) @db.UnsignedBigInt
  user_id              BigInt                       @db.UnsignedBigInt
  dish_id              BigInt                       @db.UnsignedBigInt
  recommendation_id    BigInt?                      @db.UnsignedBigInt
  event_type           user_interactions_event_type @default(VIEW)
  event_key            String                       @unique(map: "uq_interaction_event") @db.VarChar(64)
  occurred_at          DateTime
  created_at           DateTime                     @default(now())
  updated_at           DateTime                     @default(now())
  users                users                        @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "fk_user_interactions_1")
  dishes               dishes                       @relation(fields: [dish_id], references: [id], onUpdate: Restrict, map: "fk_user_interactions_2")
  recommendation_items recommendation_items?        @relation(fields: [recommendation_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_user_interactions_3")

  @@index([recommendation_id], map: "fk_user_interactions_3")
  @@index([dish_id, event_type, occurred_at], map: "ix_interaction_dish_type")
  @@index([user_id, occurred_at], map: "ix_interaction_user_time")
}

model user_preferences {
  id                      BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id                 BigInt    @unique(map: "uq_preferences_user") @db.UnsignedBigInt
  spicy_level             Int?      @db.UnsignedTinyInt
  budget_per_meal         Decimal?  @db.Decimal(12, 0)
  personalization_enabled Boolean   @default(false)
  consented_at            DateTime?
  dietary_note            String?   @db.VarChar(500)
  created_at              DateTime  @default(now())
  updated_at              DateTime  @default(now())
  users                   users     @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "fk_user_preferences_1")
}

model user_tag_preferences {
  id         BigInt                          @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    BigInt                          @db.UnsignedBigInt
  tag_id     BigInt                          @db.UnsignedBigInt
  preference user_tag_preferences_preference @default(LIKE)
  created_at DateTime                        @default(now())
  updated_at DateTime                        @default(now())
  users      users                           @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "fk_user_tag_preferences_1")
  tags       tags                            @relation(fields: [tag_id], references: [id], onUpdate: Restrict, map: "fk_user_tag_preferences_2")

  @@unique([user_id, tag_id], map: "uq_user_tag")
  @@index([tag_id], map: "fk_user_tag_preferences_2")
}

model users {
  id                           BigInt                         @id @default(autoincrement()) @db.UnsignedBigInt
  full_name                    String                         @db.VarChar(120)
  email                        String                         @unique(map: "uq_users_email") @db.VarChar(254)
    firebase_uid                 String?                        @unique(map: "uq_users_firebase_uid") @db.VarChar(128)
  phone                        String?                        @db.VarChar(20)
  password_hash                String                         @db.VarChar(255)
  role                         users_role                     @default(CUSTOMER)
  status                       users_status                   @default(ACTIVE)
  email_verified_at            DateTime?
  deactivated_at               DateTime?
  created_at                   DateTime                       @default(now())
  updated_at                   DateTime                       @default(now())
  account_tokens               account_tokens[]
  addresses                    addresses[]
  ai_conversations             ai_conversations[]
  auth_sessions                auth_sessions[]
  carts                        carts?
  favorites                    favorites[]
  order_events                 order_events[]
  orders                       orders[]
  recommendation_items         recommendation_items[]
  refunds                      refunds[]
  reviews                      reviews[]
  user_ingredient_restrictions user_ingredient_restrictions[]
  user_interactions            user_interactions[]
  user_preferences             user_preferences?
  user_tag_preferences         user_tag_preferences[]

  @@index([role, status], map: "ix_users_role_status")
}

