# E2E tests refuse to run unless this URL points to a dedicated test database.
# The database name must end with "_test" or "-test".
TEST_DATABASE_URL="mysql://root:password@127.0.0.1:3306/vi_viet_test"
# Set true only when intentionally running tests against a shared development DB.
ALLOW_SHARED_DATABASE_E2E=false

# Values required while AppModule is bootstrapped by E2E tests.
NODE_ENV="test"
JWT_ACCESS_SECRET="test-only-access-secret-at-least-32-characters"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
VNPAY_TMN_CODE="TESTCODE"
VNPAY_HASH_SECRET="test-only-vnpay-hash-secret"
VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNPAY_RETURN_URL="http://localhost:7000/api/v1/payments/vnpay/return"
FRONTEND_PAYMENT_RESULT_URL="http://localhost:3000/thanh-toan/ket-qua"
CORS_ORIGIN="http://localhost:3000"
