NODE_ENV=development
PORT=7000
API_PREFIX=api/v1
TZ=UTC
TRUST_PROXY=

# Orders and scheduled payment expiration
DEFAULT_DELIVERY_FEE=20000
PAYMENT_TIMEOUT_MINUTES=15
PAYMENT_EXPIRATION_JOB_ENABLED=true
PAYMENT_EXPIRATION_INTERVAL_MS=60000

# Frontend origins, separated by commas
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# TiDB/MySQL connection used by Prisma
DATABASE_URL="mysql://xxxxxx.root:your_tidb_password_here@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/vi_viet?sslaccept=strict"

# Authentication
JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Firebase Authentication (Google/Facebook)
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_AUTH_EMULATOR_HOST=

# VNPay sandbox
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
PUBLIC_API_URL=https://vi-viet.onrender.com
VNPAY_RETURN_URL=https://vi-viet.onrender.com/api/v1/payments/vnpay/return
FRONTEND_PAYMENT_RESULT_URL=http://localhost:3000/thanh-toan/ket-qua

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET=vi_viet
